# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
.env.production
.env.*
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# markdown files (except README.md)
*.md
!README.md
!scripts/README.md

# scripts and rules
/scripts/
!scripts/tsconfig.json
!firestore.rules.recommended
!firestore.rules.backup.*

# text files
*.txt
*.text
*.log
*.log.*
*.csv
*.json
!package.json
!package-lock.json
!tsconfig.json
!next.config.ts
*.yaml
*.yml
*.xml
*.ini
*.conf
*.config
!next.config.ts
*.cfg
*.properties
*.prop
*.settings
*.prefs
*.bak
*.backup
*.swp
*.swo
*.tmp
*.temp
*.cache
*.pid
*.seed
*.pid.lock
.clinerules/byterover-rules.md
.kilocode/rules/byterover-rules.md
.roo/rules/byterover-rules.md
.windsurf/rules/byterover-rules.md
.cursor/rules/byterover-rules.mdc
.kiro/steering/byterover-rules.md
.qoder/rules/byterover-rules.md
.augment/rules/byterover-rules.md

# Firebase service account key
firebase-service-account.json

# Windows crash dumps
*.stackdump

# User uploaded files
public/uploads/*
!public/uploads/.gitkeep

# Temporary files
temp/*
!temp/.gitkeep

# Test screenshots and artifacts
cypress/screenshots/*
cypress/videos/*
test-results/*
coverage/*

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Backup files
*.backup