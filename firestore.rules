// TEMPORARY DEBUGGING RULES - NO RESTRICTIONS
// These rules allow unrestricted access for debugging customer creation issues
// WARNING: Remove these and restore proper security rules after debugging

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY: Allow ALL operations for ALL users (including unauthenticated)
    // This removes all security restrictions to test if permissions are the issue
    match /{document=**} {
      allow read, write, create, update, delete: if true;
    }
  }
}
